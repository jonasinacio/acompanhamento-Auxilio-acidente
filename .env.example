# Copie este arquivo para `.env.local` (ignorado pelo Git) e preencha os valores.
# NUNCA faça commit de chaves reais.

# --- IA (classificação de intimações) ---
# Chave da API do Google Gemini.
GEMINI_API_KEY=

# --- Canal LegalMail ---
# RECOMENDADO: aponte o front para o backend de webhook (ver server/README.md).
# Assim a chave nunca vai para o browser e não há polling. Se definido, tem
# prioridade sobre LEGALMAIL_API_KEY.
LEGALMAIL_BACKEND_URL=

# Alternativa (polling direto): a API do LegalMail autentica pela chave no
# QUERY PARAM `api_key` (menu "Integrações"). Se LEGALMAIL_BACKEND_URL e
# LEGALMAIL_API_KEY estiverem vazios, o sistema usa a caixa SIMULADA.
#
# ATENÇÃO: a captura por polling é limitada a 60 req/min e a doc do LegalMail
# aplica timeout progressivo (10 min a 7 dias) ao detectar polling. O caminho
# recomendado é WEBHOOK (POST /api/v1/workspace/notifications/endpoint), tratado
# por parseLegalMailWebhook no backend. Idealmente rode a captura no servidor,
# não no browser (a chave não deve ir para o bundle).
LEGALMAIL_API_KEY=

# Opcionais:
# Base da API (padrão: https://app.legalmail.com.br).
LEGALMAIL_API_BASE=
# Máximo de processos consultados por sincronização de polling (padrão: 25).
LEGALMAIL_MAX_PROCESSOS=
