# Copie este arquivo para `.env.local` (ignorado pelo Git) e preencha os valores.
# NUNCA faça commit de chaves reais.

# --- IA (classificação de intimações) ---
# Chave da API do Google Gemini.
GEMINI_API_KEY=

# --- Canal LegalMail (captura por API) ---
# Se estas variáveis estiverem vazias, o sistema usa a caixa SIMULADA.
# Preencha para capturar do LegalMail real.
LEGALMAIL_API_URL=
LEGALMAIL_API_KEY=

# Opcionais — só ajuste se a API do LegalMail exigir cabeçalho/esquema
# de autenticação diferente do padrão "Authorization: Bearer <chave>".
# Ex.: para enviar a chave crua em um header próprio:
#   LEGALMAIL_AUTH_HEADER=X-Api-Key
#   LEGALMAIL_AUTH_SCHEME=
LEGALMAIL_AUTH_HEADER=
LEGALMAIL_AUTH_SCHEME=
