<?xml version="1.0" encoding="UTF-8"?>
<!--
  ZAPSIGN-CONTRATO · launchd. Servidor sempre no ar (não é agendado).
  KeepAlive = reinicia se cair; RunAtLoad = sobe junto com o Mac.
  Ajuste os caminhos /Users/jonas/... antes.
    cp com.jonasinacio.zapsign-webhook.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.jonasinacio.zapsign-webhook.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key><string>com.jonasinacio.zapsign-webhook</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/jonas/jonas-inacio-automacoes/zapsign-contrato/webhook_zapsign.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/jonas/jonas-inacio-automacoes/zapsign-contrato</string>
    <key>KeepAlive</key><true/>
    <key>RunAtLoad</key><true/>
    <key>StandardOutPath</key>
    <string>/Users/jonas/jonas-inacio-automacoes/zapsign-contrato/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/jonas/jonas-inacio-automacoes/zapsign-contrato/logs/launchd.err.log</string>
</dict>
</plist>
