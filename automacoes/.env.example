# PJ-AUTOMAÇÕES · modelo de variáveis de ambiente
# =================================================
# COPIE este arquivo para `.env` (que fica FORA do git) OU cole estas linhas
# no seu ~/.zshrc. NUNCA preencha valores aqui neste .env.example, e NUNCA
# mande token em chat, e-mail ou commit. Segredo vazado = revogar e gerar novo.
#
#   cp .env.example .env      # e edite o .env com os valores reais
#   set -a; source .env; set +a   # carrega no shell atual (ou use o ~/.zshrc)

# --- AdvBox (puxa_advbox.py) ---
ADVBOX_ENDPOINT="https://api.softwareadvbox.com.br"
ADVBOX_TOKEN=""            # Configurações → Integrações e API (gere um token novo)

# --- WhatsApp: cliente E grupo interno, TUDO via Z-API ---
# Uma instância só atende os dois. Pegue em Z-API > sua instância.
ZAPI_ENDPOINT=""           # .../instances/SEU_ID/token/SEU_TOKEN/send-text
ZAPI_TOKEN=""              # Client-Token (aba Segurança da conta Z-API)
ZAPI_GRUPO_GERAL=""        # id do grupo GERAL, ex.: 1203630...@g.us
