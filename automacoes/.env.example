# PJ-AUTOMAÇÕES · modelo de variáveis de ambiente
# =================================================
# COPIE este arquivo para `.env` (que fica FORA do git) OU cole estas linhas
# no seu ~/.zshrc. NUNCA preencha valores aqui neste .env.example, e NUNCA
# mande token em chat, e-mail ou commit. Segredo vazado = revogar e gerar novo.
#
#   cp .env.example .env      # e edite o .env com os valores reais
#   set -a; source .env; set +a   # carrega no shell atual (ou use o ~/.zshrc)

# --- AdvBox (puxa_advbox.py) ---
ADVBOX_ENDPOINT="https://api.softwareadvbox.com.br"
ADVBOX_TOKEN=""            # Configurações → Integrações e API (gere um token novo)

# --- WhatsApp ao cliente (ChatGuru) ---
# As MESMAS 4 credenciais do chatguru-mcp: ChatGuru > Configurações > Celulares.
CHATGURU_SERVER=""         # nº do servidor (ex.: 15) → monta s15.expertintegrado.app
CHATGURU_API_KEY=""        # chave de API (pessoal; gere/rotacione se vazar)
CHATGURU_ACCOUNT_ID=""     # id da conta
CHATGURU_PHONE_ID=""       # id do SEU celular na conta (não é o número do cliente)
# CHATGURU_ENDPOINT=""     # opcional: URL completa; se preenchido, ignora o SERVER

# --- Alerta no grupo interno GERAL (Z-API) ---
ZAPI_ENDPOINT=""
ZAPI_TOKEN=""
ZAPI_GRUPO_GERAL=""        # id do grupo, ex.: 1203630...@g.us
